# Copy to .env.testnet / .env.mainnet (both gitignored). Never commit real keys.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002            # 5042 for mainnet
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ERC-8004 registries. Testnet: deployed. Mainnet: NOT deployed as of 2026-09-20 -> own singleton.
ERC8004_IDENTITY=
ERC8004_REPUTATION=
ERC8004_VALIDATION=

# One key per role (cast wallet new). Demo personas hold the float.
ADMIN_PK=
EVALUATOR_PK=
AWARDER_PK=
VERIFIER_PK=
ATTESTOR_PK=
ARBITER_PK=
BUYER_PK=
SUPPLIER_1_PK=
SUPPLIER_2_PK=
SUPPLIER_3_PK=

# The default scorer is deterministic rubric arithmetic, recorded in the memo as
# `deterministic-rubric-v1`. That is the intended scorer for the award decision, not a stand-in:
# the memo is hash-anchored and re-hashed by /audit, so reproducibility is the point. `mock` is
# still accepted for older deployments and means the same thing.
# Only the deterministic scorer exists: no provider SDK, no API key read, no model called.
# Anything else is refused at startup rather than written falsely into an attestation.
LLM_PROVIDER=rubric
# Unused. Kept only so a future provider has an obvious home.
ANTHROPIC_API_KEY=
DATABASE_URL=file:./data/sealedrfq.db
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_CONTRACTS_JSON=

# Which XMTP network carries the private buyer/supplier thread after an award. Unset means
# `production`, which is the right default: it is the network that persists and costs nothing.
# `dev` is a separate network with separate identities — useful for throwaway testing, but a buyer
# on `dev` and a supplier on `production` simply cannot see each other, which looks like a bug.
# Note this has nothing to do with Arc: XMTP is not a chain this project settles on.
NEXT_PUBLIC_XMTP_ENV=production

# Charge per evaluation over x402 (Circle's facilitator settles USDC on Arc).
# Off unless X402_ENABLED=true, because the demo scripts drive /evaluate directly.
# Enabling it on a chain Circle cannot settle, or without a payout address, fails at startup
# rather than serving a paid endpoint for free.
# Tender documents. The defaults sit inside the mounted volume and need no setting.
# Sweeping deletes only files no RFQ, bid or milestone refers to — never documents when a tender
# closes, since the hash on-chain is anchored to the file and disputes outlive the award.
DOCUMENT_DIR=/data/documents
DOCUMENT_MAX_BYTES=10485760      # 10MB per file
DOCUMENT_GRACE_MS=86400000       # leave anything uploaded in the last 24h alone
DOCUMENT_SWEEP_ENABLED=true

# Bearer token for POST /rfqs/:id/award and POST /reindex. Those spend the AWARDER key and the RPC
# budget, so they are DISABLED until this is set — never open by default. `openssl rand -hex 32`.
AGENT_API_TOKEN=
# Lock the agent's CORS to the deployed web origin. The default "*" is fine locally, not in public.
CORS_ORIGIN=*

X402_ENABLED=false
X402_PAY_TO=                    # address that receives the fees
X402_PRICE=0.05                 # dollars. No "$" sign: sourcing this file would expand $0
X402_FACILITATOR_URL=           # defaults by chain: 5042 -> gateway-api, 5042002 -> gateway-api-testnet

# ── Procurement policy, read by Deploy.s.sol ────────────────────────────────
# Set once at deploy and changeable only while ADMIN_ROLE is held. See workplan §6n: the defaults
# below are the TESTNET values and they block every real first purchase — a first award is always
# 100% concentrated, so it is refused whenever it reaches the floor.
#
# For mainnet: the share cap must exceed 50% or a buyer giving one supplier half their work is
# blocked, and the floor must exceed the largest first tender you intend to admit. Run
# `./script/preflight-policy.sh` before deploying.
POLICY_MAX_AWARD_BPS=10000
POLICY_MIN_REVEALED_BIDS=2
POLICY_MIN_DEPOSIT_BPS=500
POLICY_MIN_BUYER_STAKE_BPS=500
POLICY_MAX_SUPPLIER_SHARE_BPS=6000
POLICY_CONCENTRATION_FLOOR=250000000000
POLICY_AGENT_AWARD_CAP=100000000

# ── V2 application plane ──────────────────────────────────────────────────────
# Postgres for organizations, requests and private documents. The application connects as a role
# that owns nothing, so row-level security actually applies to it; see packages/db/README.md.
APP_DATABASE_URL=postgres://sealedrfq_app:localdev@localhost:5433/sealedrfq
# Only for migrations and tests. Never the application's connection: the table owner bypasses every
# policy, which would disable tenant isolation without a single error.
ADMIN_DATABASE_URL=postgres://sealedrfq:localdev@localhost:5433/sealedrfq
# Private documents are encrypted at rest with AES-256-GCM. 32 bytes of hex; a short key is refused
# rather than padded. Generate with: openssl rand -hex 32
DOCUMENT_ENCRYPTION_KEY=
# Signs the V2 workspace session cookie. At least 32 characters; a shorter one is refused rather
# than accepted, because a weak secret makes every session forgeable.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# ---- Concordium agent registration (scripts/concordium/register-agent.mjs) ----
# A key of its own, never a reused role key. A CIS-8 binding can be taken over by whoever holds
# the private key, so binding a leaked key lets a stranger claim the agent's key at any moment.
# Grant this same key EVALUATOR_ROLE on the Arc deployment the badge claims to speak for, or the
# binding demonstrates the mechanism while attesting to nothing.
CCD_EVALUATOR_PK=
CCD_EVALUATOR_ADDRESS=
CCD_EVALUATOR_PUBKEY_COMPRESSED=
# The account that sends the registration. Either a wallet key export file, or the address plus
# the account private key the wallet copies to the clipboard. Not every Concordium wallet writes a
# key file, so the second path exists rather than depending on a menu that may not be there.
CCD_WALLET=
CCD_ACCOUNT=
CCD_ACCOUNT_SIGN_KEY=
# The origin the agent card is served from.
SITE_ORIGIN=
