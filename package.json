{
  "name": "sealedrfq",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "turbo run dev",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "local": "tools/local.sh up",
    "local:demo": "tools/local.sh demo",
    "local:warp": "tools/local.sh warp",
    "local:status": "tools/local.sh status",
    "local:down": "tools/local.sh down"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9",
    "turbo": "^2",
    "typescript": "^5.6"
  }
}
