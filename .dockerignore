# Keep the build context small and secrets out of it.
.env
.env.*
!.env.example
# Concordium wallet key exports. gitignore keeps them out of the repo; this keeps them out of a
# build context, which gitignore has no say over.
*.export
*.export.json
.git
.local
node_modules
**/node_modules
**/dist
**/.next
**/.turbo
contracts/out
contracts/cache
contracts/cache-arc
contracts/broadcast
contracts/lib
apps/web
web
*.db
*.db-*
