{
  "name": "@sealedrfq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./requests": {
      "types": "./dist/requests.d.ts",
      "import": "./dist/requests.js"
    },
    "./documents": {
      "types": "./dist/documents.d.ts",
      "import": "./dist/documents.js"
    },
    "./workspace": {
      "types": "./dist/workspace.d.ts",
      "import": "./dist/workspace.js"
    }
  },
  "scripts": {
    "db:up": "docker compose -f ../../compose.yaml up -d",
    "db:migrate": "./scripts/migrate.sh",
    "db:reset": "./scripts/migrate.sh --reset",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "viem": "^2"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.9"
  },
  "types": "./dist/index.d.ts"
}
